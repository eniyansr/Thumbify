# ====================================================================
# THUMBIFY Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file or credentials to source control.
# ====================================================================

# Required Telegram MTProto Credentials
# Get these from https://my.telegram.org (under 'API development tools')
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here

# Telegram Bot Token
# Obtain this from @BotFather on Telegram (e.g., 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TG_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Owner Telegram User ID (numeric)
# Only this Telegram user ID can use or send commands to the bot.
# Send /id to this bot or check @userinfobot to find your ID.
OWNER_ID=123456789

# Optional Configuration Settings
# Maximum supported file size in bytes (Default: 419430400 = 400 MB)
MAX_FILE_SIZE=419430400

# Maximum concurrent processing jobs (Default: 1 to ensure reliability)
MAX_CONCURRENT_JOBS=1

# Delivery format: true = Document card with thumbnail & download button (default)
#                  false = Inline playable video player
FORCE_DOCUMENT=true

# Local directories
DOWNLOAD_DIR=downloads
THUMBNAIL_PATH=assets/thumbnail.jpg
LOG_LEVEL=INFO
RETRY_COUNT=3
TRANSFER_TIMEOUT=3600
